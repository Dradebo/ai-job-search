# API runtime and app security
DATABASE_PATH=/data/app.db
APP_ORIGIN=https://your-pwa.example.com
# Add any preview origins as a comma-separated list only when needed for testing
BOOTSTRAP_EMAIL=replace-me@example.com
BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
INVITE_BASE_URL=https://your-pwa.example.com
# Optional comma-separated invite administrators; empty means BOOTSTRAP_EMAIL only.
INVITER_EMAILS=
SESSION_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE=none
PORT=8787

# Optional employer-owned Greenhouse board slugs, comma-separated.
# Leave empty rather than inheriting a sample/example catalog.
GREENHOUSE_BOARDS=
GREENHOUSE_MAX_BOARDS=12

# Optional official USAJOBS search API credentials.
# The User-Agent value must be the email associated with your API request.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
